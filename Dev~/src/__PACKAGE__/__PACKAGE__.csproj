<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>__PACKAGE__</AssemblyName>
    <RootNamespace>__NAMESPACE__</RootNamespace>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Unity.Mathematics for CI compilation only.
    PrivateAssets="All" = compile reference, never copied to output.
    Unity resolves this via UPM com.unity.mathematics at runtime.
  -->
  <ItemGroup>
    <PackageReference Include="UnityMathematics" Version="$(UnityMathematicsVersion)" PrivateAssets="All" />
  </ItemGroup>

  <!-- Source lives in the Unity package folder. This csproj just points at it. -->
  <ItemGroup>
    <Compile Include="../../../Runtime/**/*.cs" />
    <Compile Remove="../../../Runtime/**/bin/**/*.cs" />
    <Compile Remove="../../../Runtime/**/obj/**/*.cs" />
  </ItemGroup>
</Project>
