<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- NoDeps: Unity.Mathematics without UnityEngine dependency for test runtime -->
  <ItemGroup>
    <PackageReference Include="UnityMathematics.NoDeps" Version="$(UnityMathematicsVersion)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" PrivateAssets="all" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/__PACKAGE__/__PACKAGE__.csproj" />
  </ItemGroup>

  <!-- Test files live in the Unity Tests/ folder -->
  <ItemGroup>
    <Compile Include="../../../__PACKAGE__.Tests/**/*.Tests.cs" />
    <Compile Remove="../../../__PACKAGE__.Tests/**/bin/**" />
    <Compile Remove="../../../__PACKAGE__.Tests/**/obj/**" />
  </ItemGroup>
</Project>
